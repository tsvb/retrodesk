[
  {
    "id": "dolphin",
    "name": "Dolphin",
    "systems": ["gc", "wii"],
    "source": { "type": "dolphin", "url": "https://dolphin-emu.org/update/latest/beta/" },
    "assetPattern": "^dolphin-\\d+-x64\\.7z$",
    "fallback": { "version": "2609", "url": "https://dl.dolphin-emu.org/releases/2609/dolphin-2609-x64.7z" },
    "archiveType": "7z",
    "exe": "Dolphin.exe",
    "args": ["-b", "-C", "Dolphin.Display.Fullscreen=True", "-C", "Dolphin.Interface.ConfirmStop=False", "-e", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "portable.txt", "kind": "file" }],
    "userData": ["User", "portable.txt"],
    "needsVcRedist": true,
    "romKind": "file",
    "notes": "Archive top folder Dolphin-x64/ is flattened. -b exits when emulation stops; portable.txt => User/ next to exe."
  },
  {
    "id": "pcsx2",
    "name": "PCSX2",
    "systems": ["ps2"],
    "source": { "type": "github", "repo": "PCSX2/pcsx2" },
    "assetPattern": "^pcsx2-v[\\d.]+-windows-x64-Qt\\.7z$",
    "fallback": { "version": "2.8.2", "url": "https://github.com/PCSX2/pcsx2/releases/download/v2.8.2/pcsx2-v2.8.2-windows-x64-Qt.7z" },
    "archiveType": "7z",
    "exe": "pcsx2-qt.exe",
    "args": ["-batch", "-nogui", "-fullscreen", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "portable.txt", "kind": "file" }],
    "userData": ["bios", "memcards", "sstates", "inis", "snaps", "cheats", "patches", "textures", "covers", "gamesettings", "portable.txt"],
    "needsVcRedist": true,
    "romKind": "file",
    "firmware": [
      {
        "label": "PS2 BIOS",
        "finder": "ps2Bios",
        "all": true,
        "copyTo": "bios/",
        "copyWhen": "missing",
        "installed": { "nonEmptyDir": "bios" },
        "required": true,
        "message": "PS2 needs a BIOS dump. Put your PS2 BIOS (e.g. SCPH-70012.bin) in {bios}\\ps2."
      }
    ],
    "config": {
      "file": "inis/PCSX2.ini",
      "set": [
        { "section": "UI", "key": "SetupWizardIncomplete", "value": "false" },
        { "section": "UI", "key": "ConfirmShutdown", "value": "false" },
        { "section": "Folders", "key": "Bios", "value": "bios" }
      ],
      "hook": "pcsx2BiosFile"
    },
    "notes": "BIOS: RetroDesk copies PS2 BIOS dumps from <bios>/ps2 (or 4 MB .bin files in <bios>) into bios/ and writes inis/PCSX2.ini [Filenames] BIOS."
  },
  {
    "id": "rpcs3",
    "name": "RPCS3",
    "systems": ["ps3"],
    "source": { "type": "github", "repo": "RPCS3/rpcs3-binaries-win" },
    "assetPattern": "^rpcs3-v[\\d.]+-\\d+-[0-9a-f]+_win64_msvc\\.7z$",
    "fallback": null,
    "archiveType": "7z",
    "exe": "rpcs3.exe",
    "args": ["--no-gui", "--fullscreen", "{rom}"],
    "uiArgs": [],
    "portable": [],
    "userData": ["dev_hdd0", "dev_hdd1", "dev_flash", "dev_flash2", "dev_flash3", "dev_usb000", "config", "savestates", "games.yml"],
    "needsVcRedist": true,
    "romKind": "ps3",
    "firmware": [
      {
        "label": "PS3 firmware",
        "dirs": ["", "ps3"],
        "name": "PS3UPDAT.PUP",
        "installed": { "anyOf": ["dev_flash/vsh/module", "dev_flash/sys/external"] },
        "required": true,
        "message": "PS3 games need the official firmware. Download PS3UPDAT.PUP from playstation.com and put it in {bios}.",
        "manual": "PS3 firmware is not installed in RPCS3 yet. Open RPCS3 (Settings > Emulators) and use File > Install Firmware with {file}."
      }
    ],
    "notes": "Always portable. {rom} = EBOOT.BIN found inside a game folder, or the ISO. Firmware: rpcs3.exe --installfw <bios>/PS3UPDAT.PUP."
  },
  {
    "id": "eden",
    "name": "Eden",
    "systems": ["switch"],
    "source": { "type": "forgejo", "api": "https://git.eden-emu.dev/api/v1", "repo": "eden-emu/eden" },
    "assetPattern": "^Eden-Windows-v[\\d.]+-amd64-msvc-standard\\.zip$",
    "fallback": { "version": "0.2.1", "url": "https://stable.eden-emu.dev/v0.2.1/Eden-Windows-v0.2.1-amd64-msvc-standard.zip" },
    "archiveType": "zip",
    "exe": "eden.exe",
    "args": ["-f", "-g", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "user", "kind": "dir" }],
    "userData": ["user"],
    "needsVcRedist": true,
    "romKind": "file",
    "firmware": [
      {
        "label": "prod.keys",
        "dirs": ["", "switch"],
        "name": "prod.keys",
        "copyTo": "user/keys/prod.keys",
        "copyWhen": "newer",
        "installed": { "anyOf": ["user/keys/prod.keys"] },
        "required": true,
        "message": "Switch games need your prod.keys. Put it in {bios} (or {bios}\\switch)."
      },
      {
        "label": "title.keys",
        "dirs": ["", "switch"],
        "name": "title.keys",
        "copyTo": "user/keys/title.keys",
        "copyWhen": "newer",
        "installed": { "anyOf": ["user/keys/title.keys"] },
        "required": false
      },
      {
        "label": "Switch firmware",
        "dirs": ["switch/firmware"],
        "pattern": "\\.nca$",
        "all": true,
        "copyTo": "user/nand/system/Contents/registered/",
        "copyWhen": "notInstalled",
        "installed": { "nonEmptyDir": "user/nand/system/Contents/registered" },
        "required": true,
        "message": "Switch firmware is not installed. Put your firmware dump (*.nca files) in {bios}\\switch\\firmware, or install it from Eden (Tools > Install Firmware)."
      }
    ],
    "notes": "Keys: RetroDesk copies prod.keys/title.keys from <bios> (or <bios>/switch) into user/keys/. Firmware must be installed via Eden's UI."
  },
  {
    "id": "azahar",
    "name": "Azahar",
    "systems": ["3ds"],
    "source": { "type": "github", "repo": "azahar-emu/azahar" },
    "assetPattern": "^azahar-windows-msvc-[\\d.]+\\.zip$",
    "fallback": null,
    "archiveType": "zip",
    "exe": "azahar.exe",
    "args": ["-f", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "user", "kind": "dir" }],
    "userData": ["user"],
    "needsVcRedist": false,
    "romKind": "file",
    "notes": "Zip uses backslash entry names (7za handles them); versioned top folder is flattened."
  },
  {
    "id": "cemu",
    "name": "Cemu",
    "systems": ["wiiu"],
    "source": { "type": "github", "repo": "cemu-project/Cemu" },
    "assetPattern": "^cemu-[\\d.]+-windows-x64\\.zip$",
    "fallback": { "version": "2.6", "url": "https://github.com/cemu-project/Cemu/releases/download/v2.6/cemu-2.6-windows-x64.zip" },
    "archiveType": "zip",
    "exe": "Cemu.exe",
    "args": ["-f", "-g", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "portable", "kind": "dir" }],
    "userData": ["portable"],
    "needsVcRedist": true,
    "romKind": "wiiu",
    "notes": "Folder games: {rom} = code/*.rpx inside the title folder."
  },
  {
    "id": "xemu",
    "name": "xemu",
    "systems": ["xbox"],
    "source": { "type": "github", "repo": "xemu-project/xemu" },
    "assetPattern": "^xemu-win-x86_64-release\\.zip$",
    "fallback": { "version": "0.8.136", "url": "https://github.com/xemu-project/xemu/releases/latest/download/xemu-win-x86_64-release.zip" },
    "archiveType": "zip",
    "exe": "xemu.exe",
    "args": ["-full-screen", "-dvd_path", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "xemu.toml", "kind": "file", "content": "[general]\nshow_welcome = false\n" }],
    "userData": ["xemu.toml", "eeprom.bin"],
    "needsVcRedist": false,
    "romKind": "file",
    "firmware": [
      { "id": "mcpx", "label": "mcpx_1.0.bin", "dirs": ["", "xbox"], "name": "mcpx_1.0.bin", "required": true },
      { "id": "flash", "label": "Complex_4627.bin", "dirs": ["", "xbox"], "pattern": "^complex_4627.*\\.bin$", "required": true },
      { "id": "hdd", "label": "xbox_hdd.qcow2", "dirs": ["", "xbox"], "name": "xbox_hdd.qcow2", "required": true }
    ],
    "missingMessage": "Xbox needs {missing} in {bios}.",
    "config": {
      "file": "xemu.toml",
      "set": [
        { "section": "general", "key": "show_welcome", "value": "false" },
        { "section": "sys.files", "key": "bootrom_path", "value": "{mcpx}", "quote": "toml" },
        { "section": "sys.files", "key": "flashrom_path", "value": "{flash}", "quote": "toml" },
        { "section": "sys.files", "key": "hdd_path", "value": "{hdd}", "quote": "toml" }
      ]
    },
    "postInstall": [
      {
        "label": "Xbox HDD image",
        "url": "https://github.com/xemu-project/xemu-dashboard/releases/latest/download/xbox_hdd.qcow2",
        "to": "xbox_hdd.qcow2",
        "unless": ["xbox_hdd.qcow2", "xbox/xbox_hdd.qcow2"]
      }
    ],
    "notes": "xemu.toml [sys.files] is pointed at <bios>/mcpx_1.0.bin, Complex_4627.bin, xbox_hdd.qcow2 (also accepted under <bios>/xbox)."
  },
  {
    "id": "vita3k",
    "name": "Vita3K",
    "systems": ["vita"],
    "source": { "type": "github", "repo": "Vita3K/Vita3K", "tag": "continuous" },
    "assetPattern": "^windows-latest\\.zip$",
    "fallback": { "version": "continuous", "url": "https://github.com/Vita3K/Vita3K/releases/download/continuous/windows-latest.zip" },
    "archiveType": "zip",
    "exe": "Vita3K.exe",
    "args": ["-F", "-r", "{titleId}"],
    "uiArgs": [],
    "portable": [{ "path": "portable", "kind": "dir" }],
    "userData": ["portable"],
    "needsVcRedist": false,
    "romKind": "vita",
    "firmware": [
      {
        "label": "Vita firmware",
        "dirs": ["", "vita"],
        "name": "PSVUPDAT.PUP",
        "installed": { "dirNamed": "vs0", "depth": 3 },
        "required": true,
        "message": "Vita games need the official firmware. Put PSVUPDAT.PUP in {bios}, then install it from Vita3K."
      }
    ],
    "notes": "Installed games launch by title ID (from [PCSE00000] in the name or sce_sys/param.sfo); .vpk/.zip are passed as content path (install + run)."
  },
  {
    "id": "ppsspp",
    "name": "PPSSPP",
    "systems": ["psp"],
    "source": { "type": "github", "repo": "hrydgard/ppsspp" },
    "assetPattern": "^PPSSPP-v[\\d.]+-Windows-x64\\.zip$",
    "fallback": null,
    "archiveType": "zip",
    "exe": "PPSSPPWindows64.exe",
    "args": ["--fullscreen", "--pause-menu-exit", "{rom}"],
    "uiArgs": [],
    "portable": [],
    "userData": ["memstick"],
    "needsVcRedist": false,
    "romKind": "file",
    "notes": "Portable by default (memstick/ next to exe). Never create installed.txt."
  },
  {
    "id": "duckstation",
    "name": "DuckStation",
    "systems": ["psx"],
    "source": { "type": "github", "repo": "stenzek/duckstation", "tag": "latest" },
    "assetPattern": "^duckstation-windows-x64-release\\.zip$",
    "fallback": { "version": "latest", "url": "https://github.com/stenzek/duckstation/releases/download/latest/duckstation-windows-x64-release.zip" },
    "archiveType": "zip",
    "exe": "duckstation-qt-x64-ReleaseLTCG.exe",
    "args": ["-batch", "-nogui", "-fullscreen", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "portable.txt", "kind": "file" }],
    "userData": ["memcards", "savestates", "settings.ini", "bios", "gamesettings", "covers", "screenshots", "cheats", "portable.txt"],
    "needsVcRedist": false,
    "romKind": "file",
    "config": {
      "file": "settings.ini",
      "set": [
        { "section": "Main", "key": "SetupWizardIncomplete", "value": "false" },
        { "section": "Main", "key": "ConfirmPowerOff", "value": "false" },
        { "section": "BIOS", "key": "SearchDirectory", "value": "{bios}" }
      ]
    },
    "notes": "settings.ini [BIOS] SearchDirectory is pointed at the RetroDesk BIOS dir."
  }
]
