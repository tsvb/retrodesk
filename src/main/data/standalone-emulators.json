[
  {
    "id": "dolphin",
    "name": "Dolphin",
    "systems": ["gc", "wii"],
    "source": { "type": "dolphin", "url": "https://dolphin-emu.org/update/latest/beta/" },
    "assetPattern": "^dolphin-\\d+-x64\\.7z$",
    "fallback": { "version": "2609", "url": "https://dl.dolphin-emu.org/releases/2609/dolphin-2609-x64.7z" },
    "archiveType": "7z",
    "exe": "Dolphin.exe",
    "args": ["-b", "-C", "Dolphin.Display.Fullscreen=True", "-C", "Dolphin.Interface.ConfirmStop=False", "-e", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "portable.txt", "kind": "file" }],
    "userData": ["User", "portable.txt"],
    "needsVcRedist": true,
    "romKind": "file",
    "notes": "Archive top folder Dolphin-x64/ is flattened. -b exits when emulation stops; portable.txt => User/ next to exe.",
    "macos": {
      "source": { "type": "dolphin", "url": "https://dolphin-emu.org/update/latest/beta/" },
      "fallback": null,
      "archiveType": "dmg",
      "exe": "Dolphin.app/Contents/MacOS/Dolphin",
      "notes": "Universal .dmg from the update feed's macOS artifact. Data in ~/Library/Application Support/Dolphin."
    }
  },
  {
    "id": "pcsx2",
    "name": "PCSX2",
    "systems": ["ps2"],
    "source": { "type": "github", "repo": "PCSX2/pcsx2" },
    "assetPattern": "^pcsx2-v[\\d.]+-windows-x64-Qt\\.7z$",
    "fallback": { "version": "2.8.2", "url": "https://github.com/PCSX2/pcsx2/releases/download/v2.8.2/pcsx2-v2.8.2-windows-x64-Qt.7z" },
    "archiveType": "7z",
    "exe": "pcsx2-qt.exe",
    "args": ["-batch", "-nogui", "-fullscreen", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "portable.txt", "kind": "file" }],
    "userData": ["bios", "memcards", "sstates", "inis", "snaps", "cheats", "patches", "textures", "covers", "gamesettings", "portable.txt"],
    "needsVcRedist": true,
    "romKind": "file",
    "firmware": [
      {
        "label": "PS2 BIOS",
        "finder": "ps2Bios",
        "all": true,
        "copyTo": "bios/",
        "copyWhen": "missing",
        "installed": { "nonEmptyDir": "bios" },
        "required": true,
        "message": "PS2 needs a BIOS dump. Put your PS2 BIOS (e.g. SCPH-70012.bin) in {bios}\\ps2."
      }
    ],
    "config": {
      "file": "inis/PCSX2.ini",
      "set": [
        { "section": "UI", "key": "SetupWizardIncomplete", "value": "false" },
        { "section": "UI", "key": "ConfirmShutdown", "value": "false" },
        { "section": "Folders", "key": "Bios", "value": "bios" }
      ],
      "hook": "pcsx2BiosFile"
    },
    "notes": "BIOS: RetroDesk copies PS2 BIOS dumps from <bios>/ps2 (or 4 MB .bin files in <bios>) into bios/ and writes inis/PCSX2.ini [Filenames] BIOS.",
    "macos": {
      "assetPattern": "^pcsx2-v[\\d.]+-macos-Qt\\.tar\\.xz$",
      "fallback": { "version": "2.8.2", "url": "https://github.com/PCSX2/pcsx2/releases/download/v2.8.2/pcsx2-v2.8.2-macos-Qt.tar.xz" },
      "archiveType": "tar.xz",
      "exe": "PCSX2.app/Contents/MacOS/PCSX2",
      "dataDir": "~/Library/Application Support/PCSX2"
    }
  },
  {
    "id": "rpcs3",
    "name": "RPCS3",
    "systems": ["ps3"],
    "source": { "type": "github", "repo": "RPCS3/rpcs3-binaries-win" },
    "assetPattern": "^rpcs3-v[\\d.]+-\\d+-[0-9a-f]+_win64_msvc\\.7z$",
    "fallback": {
      "version": "build-46aee28f85b9cecc8fd0e5dee0c771f9c88cd27a",
      "url": "https://github.com/RPCS3/rpcs3-binaries-win/releases/download/build-46aee28f85b9cecc8fd0e5dee0c771f9c88cd27a/rpcs3-v0.0.43-20206-46aee28f_win64_msvc.7z"
    },
    "archiveType": "7z",
    "exe": "rpcs3.exe",
    "args": ["--no-gui", "--fullscreen", "{rom}"],
    "uiArgs": [],
    "portable": [],
    "userData": ["dev_hdd0", "dev_hdd1", "dev_flash", "dev_flash2", "dev_flash3", "dev_usb000", "config", "savestates", "games.yml"],
    "needsVcRedist": true,
    "romKind": "ps3",
    "firmware": [
      {
        "label": "PS3 firmware",
        "dirs": ["", "ps3"],
        "name": "PS3UPDAT.PUP",
        "installed": { "anyOf": ["dev_flash/vsh/module", "dev_flash/sys/external"] },
        "required": true,
        "message": "PS3 games need the official firmware. Download PS3UPDAT.PUP from playstation.com and put it in {bios}.",
        "manual": "PS3 firmware is not installed in RPCS3 yet. Open RPCS3 (Settings > Emulators) and use File > Install Firmware with {file}."
      }
    ],
    "notes": "Always portable. {rom} = EBOOT.BIN found inside a game folder, or the ISO. Firmware: rpcs3.exe --installfw <bios>/PS3UPDAT.PUP.",
    "macos": {
      "dataDir": "~/Library/Application Support/rpcs3",
      "arm64": {
        "source": { "type": "github", "repo": "RPCS3/rpcs3-binaries-mac-arm64" },
        "assetPattern": "^rpcs3-v[\\d.]+-\\d+-[0-9a-f]+_macos_aarch64\\.7z$",
        "fallback": {
          "version": "build-ba4a4b561edb562d9fd58268edaf927fa436f408",
          "url": "https://github.com/RPCS3/rpcs3-binaries-mac-arm64/releases/download/build-ba4a4b561edb562d9fd58268edaf927fa436f408/rpcs3-v0.0.43-20217-ba4a4b56_macos_aarch64.7z"
        }
      },
      "x64": {
        "source": { "type": "github", "repo": "RPCS3/rpcs3-binaries-mac" },
        "assetPattern": "^rpcs3-v[\\d.]+-\\d+-[0-9a-f]+_macos(?!_aarch64)[^.]*\\.(7z|dmg)$",
        "fallback": null
      },
      "exe": "rpcs3.app/Contents/MacOS/rpcs3"
    }
  },
  {
    "id": "eden",
    "name": "Eden",
    "systems": ["switch"],
    "source": { "type": "forgejo", "api": "https://git.eden-emu.dev/api/v1", "repo": "eden-emu/eden" },
    "assetPattern": "^Eden-Windows-v[\\d.]+-amd64-msvc-standard\\.zip$",
    "fallback": { "version": "0.2.1", "url": "https://stable.eden-emu.dev/v0.2.1/Eden-Windows-v0.2.1-amd64-msvc-standard.zip" },
    "archiveType": "zip",
    "exe": "eden.exe",
    "args": ["-f", "-g", "{rom}"],
    "uiArgs": [],
    "portable": [{ "path": "user", "kind": "dir" }],
    "userData": ["user"],
    "createDirs": ["user/config"],
    "needsVcRedist": true,
    "romKind": "file",
    "firmware": [
      {
        "label": "prod.keys",
        "dirs": ["", "switch"],
        "name": "prod.keys",
        "copyTo": "user/keys/prod.keys",
        "copyWhen": "newer",
        "installed": { "anyOf": ["user/keys/prod.keys"] },
        "required": true,
        "message": "Switch games need your prod.keys. Put it in {bios} (or {bios}\\switch)."
      },
      {
        "label": "title.keys",
        "dirs": ["", "switch"],
        "name": "title.keys",
        "copyTo": "user/keys/title.keys",
        "copyWhen": "newer",
        "installed": { "anyOf": ["user/keys/title.keys"] },
        "required": false
      },
      {
        "label": "Switch firmware",
        "dirs": ["switch/firmware"],
        "pattern": "\\.nca$",
        "recursive": true,
        "folderFile": "00",
        "all": true,
        "copyTo": "user/nand/system/Contents/registered/",
        "copyWhen": "mirror",
        "installed": { "nonEmptyDir": "user/nand/system/Contents/registered" },
        "required": true,
        "message": "Switch firmware is not installed. Put your firmware dump (the .nca files, a sub folder is fine) in {bios}\\switch\\firmware, or install it in Eden (Tools > Install Firmware from Folder)."
      }
    ],
    "crashLog": {
      "file": "user/log/eden_log.txt",
      "patterns": ["Emulated program broke execution", "<Critical>"],
      "message": "Eden reports that the game crashed inside the emulator, so it will not get past its loading screen. Quit it from the quick menu."
    },
    "config": {
      "file": "user/config/qt-config.ini",
      "sep": "=",
      "set": [{ "section": "Renderer", "key": "use_asynchronous_shaders", "value": "true", "ifDefault": true }]
    },
    "notes": "Keys: RetroDesk copies prod.keys/title.keys from <bios> (or <bios>/switch) into user/keys/. Firmware: the .nca files under <bios>/switch/firmware (sub folders and <id>.nca/00 folders included) are mirrored into user/nand/system/Contents/registered/, replacing what is there when the set changes, as Eden's own installer does. Eden's firmware check looks for the Mii Edit applet, and Miis in games only work with it (its Mii editor runs from firmware). user/config is created up front so Eden skips its first-run migration prompt. Eden keeps running after a game aborts (svcBreak) or its CPU emulator asserts, so its log is followed for those lines. Async shader building is turned on unless the player set it themselves: with it off, every new shader freezes the game while the driver compiles it.",
    "macos": {
      "assetPattern": "^Eden-macOS-v[\\d.]+\\.dmg$",
      "fallback": { "version": "0.2.1", "url": "https://stable.eden-emu.dev/v0.2.1/Eden-macOS-v0.2.1.dmg" },
      "archiveType": "dmg",
      "exe": "Eden.app/Contents/MacOS/eden",
      "archs": ["arm64"],
      "dataDir": "~/.local/share/eden",
      "createDirs": ["~/.config/eden"],
      "firmware": [
        {
          "label": "prod.keys",
          "dirs": ["", "switch"],
          "name": "prod.keys",
          "copyTo": "keys/prod.keys",
          "copyWhen": "newer",
          "installed": { "anyOf": ["keys/prod.keys"] },
          "required": true,
          "message": "Switch games need your prod.keys. Put it in {bios} (or {bios}\\switch)."
        },
        { "label": "title.keys", "dirs": ["", "switch"], "name": "title.keys", "copyTo": "keys/title.keys", "copyWhen": "newer", "installed": { "anyOf": ["keys/title.keys"] }, "required": false },
        {
          "label": "Switch firmware",
          "dirs": ["switch/firmware"],
          "pattern": "\\.nca$",
          "recursive": true,
          "folderFile": "00",
          "all": true,
          "copyTo": "nand/system/Contents/registered/",
          "copyWhen": "mirror",
          "installed": { "nonEmptyDir": "nand/system/Contents/registered" },
          "required": true,
          "message": "Switch firmware is not installed. Put your firmware dump (the .nca files, a sub folder is fine) in {bios}\\switch\\firmware, or install it in Eden (Tools > Install Firmware from Folder)."
        }
      ],
      "crashLog": {
        "file": "log/eden_log.txt",
        "patterns": ["Emulated program broke execution", "<Critical>"],
        "message": "Eden reports that the game crashed inside the emulator, so it will not get past its loading screen. Quit it from the quick menu."
      },
      "config": {
        "file": "~/.config/eden/qt-config.ini",
        "sep": "=",
        "set": [{ "section": "Renderer", "key": "use_asynchronous_shaders", "value": "true", "ifDefault": true }]
      },
      "notes": "Apple Silicon only. MoltenVK compiles pipelines slowly, so async shaders matter most here. Eden uses XDG folders on macOS, not Application Support: keys and firmware go to ~/.local/share/eden (keys/, nand/), its config to ~/.config/eden ($XDG_DATA_HOME / $XDG_CONFIG_HOME when set). Its CPU emulator is Dynarmic only (no NCE build for macOS)."
    }
  },
  {
    "id": "azahar",
    "name": "Azahar",
    "systems": ["3ds"],
    "source": { "type": "github", "repo": "azahar-emu/azahar" },
