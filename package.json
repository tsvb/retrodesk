{
  "name": "retrodesk",
  "version": "0.1.0",
  "description": "RetroDesk - a Retroid Pocket style emulation console experience for Windows desktops",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --x64",
    "e2e": "electron-vite build && node scripts/e2e-smoke.mjs",
    "e2e:play": "electron-vite build && node scripts/e2e-play.mjs"
  },
  "author": "tim",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "7zip-bin": "^5.2.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
